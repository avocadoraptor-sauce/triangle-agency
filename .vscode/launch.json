  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Python Debugger: Django",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "args": [
        "triangle_agency.asgi:application",
        "--host",
        "0.0.0.0",
        "--reload"
      ],
      "django": true,
      "autoStartBrowser": false,
      "program": "${workspaceFolder}/.venv/bin/uvicorn"
    }
  ]
}